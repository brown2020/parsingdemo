rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * User data is keyed by Firebase Auth uid.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Identity fields a browser may change. Balances and provider secrets are server-only.
    function isValidProfileUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['email', 'contactEmail', 'displayName', 'photoUrl', 'emailVerified'])
        && (!changed.hasAny(['email']) || (request.resource.data.email is string && request.resource.data.email.size() < 320))
        && (!changed.hasAny(['contactEmail']) || (request.resource.data.contactEmail is string && request.resource.data.contactEmail.size() < 320))
        && (!changed.hasAny(['displayName']) || (request.resource.data.displayName is string && request.resource.data.displayName.size() < 200))
        && (!changed.hasAny(['photoUrl']) || (request.resource.data.photoUrl is string && request.resource.data.photoUrl.size() < 4096))
        && (!changed.hasAny(['emailVerified']) || request.resource.data.emailVerified is bool);
    }

    // Deny by default.
    match /{document=**} {
      allow read, write: if false;
    }

    // User-scoped data.
    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);

      // Documents uploaded/converted by the user.
      match /documents/{docId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // Payment records are written by the Admin SDK from the Stripe webhook.
      match /payments/{paymentId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }

      // Profile doc(s) under the user. Clients cannot create, delete, or touch balances.
      match /profile/{profileId} {
        allow read: if isOwner(userId);
        allow create, delete: if false;
        allow update: if isOwner(userId) && isValidProfileUpdate();
      }
    }
  }
}
